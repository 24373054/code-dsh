{
  "name": "@sealwax/dsh-trust-platform",
  "version": "0.7.1",
  "description": "Embedded identity and payment-governance trust plane for multi-agent cross-border payment workflows.",
  "type": "module",
  "main": "src/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./src/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build:client": "node scripts/build-client.mjs",
    "pack:check": "node scripts/build-client.mjs && npm pack --dry-run"
  },
  "license": "MIT",
  "author": "sealwax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/24373054/code-dsh.git"
  },
  "homepage": "https://github.com/24373054/code-dsh#readme",
  "bugs": {
    "url": "https://github.com/24373054/code-dsh/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "identity",
    "trust",
    "payments",
    "cross-border",
    "agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "~3.18.5",
    "esbuild": "^0.25.12"
  }
}
